{
  "name": "bsmtap",
  "version": "1.0.2",
  "description": "BSM-to-JSON streaming daemon — taps macOS OpenBSM audit events into structured JSON Lines",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spantree/bsmtap.git"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build --compile src/main.ts --outfile bsmtap",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:ci": "biome check --diagnostic-level=error .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
